55-cff3-4d04-85ed-c9b36cfef32a"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.48550/arxiv.2503.13276"}],"license":"cc_by","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Research","urls":["https://hdl.handle.net/11370/aeb5a955-cff3-4d04-85ed-c9b36cfef32a","https://research.rug.nl/en/publications/aeb5a955-cff3-4d04-85ed-c9b36cfef32a","https://doi.org/10.48550/arXiv.2503.13276"],"refereed":"nonPeerReviewed","hostedBy":{"key":"eurocrisdris::ddb606710dacf8134d76a791c9a9fb1e","value":"University of Groningen Research Portal"},"collectedFrom":{"key":"eurocrisdris::ddb606710dacf8134d76a791c9a9fb1e","value":"University of Groningen Research Portal"}}],"links":[],"otherTitles":["A tableau-based proof"],"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Krabbe, Frederik","name":"Frederik","surname":"Krabbe","rank":1,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"FOS: Economics and business"},"provenance":null},{"subject":{"scheme":"keyword","value":"Statistics Theory"},"provenance":null},{"subject":{"scheme":"keyword","value":"Econometrics (econ.EM)"},"provenance":null},{"subject":{"scheme":"keyword","value":"FOS: Mathematics"},"provenance":null},{"subject":{"scheme":"keyword","value":"Econometrics"},"provenance":null},{"subject":{"scheme":"keyword","value":"Statistics Theory (math.ST)"},"provenance":null},{"subject":{"scheme":"FOS","value":"0101 mathematics"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null}],"mainTitle":"Asymptotic Properties of the Maximum Likelihood Estimator for Markov-switching Observation-driven Models","subTitle":null,"descriptions":["A Markov-switching observation-driven model is a stochastic process $((S_t,Y_t))_{t \\in \\mathbb{Z}}$ where $(S_t)_{t \\in \\mathbb{Z}}$ is an unobserved Markov chain on a finite set and $(Y_t)_{t \\in \\mathbb{Z}}$ is an observed stochastic process such that the conditional distribution of $Y_t$ given $(Y_τ)_{τ\\leq t-1}$ and $(S_τ)_{τ\\leq t}$ depends on $(Y_τ)_{τ\\leq t-1}$ and $S_t$. In this paper, we prove consistency and asymptotic normality of the maximum likelihood estimator for such model. As a special case, we also give conditions under which the maximum likelihood estimator for the widely applied Markov-switching generalised autoregressive conditional heteroscedasticity model introduced by Haas, Mittnik, and Paolella (2004b) is consistent and asymptotically normal."],"publicationDate":"2026-01-01","publisher":"Elsevier BV","embargoEndDate":"2024-12-01","sources":["Crossref","Krabbe, F 2024 'Asymptotic Properties of the Maximum Likelihood Estimator for Markov-switching Observation-driven Models'. < https://arxiv.org/abs/2412.19555 >"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::6106defccf917d558fd3389b755519b8","originalIds":["10.2139/ssrn.6050501","50|doiboost____|b5edee71d61023d14b5f310bf84ce1f7","50|datacite____::6106defccf917d558fd3389b755519b8","10.48550/arxiv.2412.19555","50|od________18::42a81cd92bc545e83fd09d2323d5fd34","oai:arXiv.org:2412.19555","oai:pure.atira.dk:publications/1ef46d5c-fec4-4cdf-a058-b430d8ae84fa","50|pure_au_____::db9b9f90b4f88f84f72e603901e954c0"],"pids":[{"scheme":"doi","value":"10.2139/ssrn.6050501"},{"scheme":"doi","value":"10.48550/arxiv.2412.19555"},{"scheme":"arXiv","value":"2412.19555"}],