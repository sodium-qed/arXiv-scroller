{"header":{"numFound":1,"maxScore":1.0,"queryTime":41,"page":1,"pageSize":100},"results":[{"authors":[{"id":null,"fullName":"Salone, Jean-Jacques","name":"Jean-Jacques","surname":"Salone","rank":1,"pid":{"id":{"scheme":"orcid_pending","value":"0009-0001-1033-5694"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":null,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"[MATH.MATH-CO] Mathematics [math]/Combinatorics [math.CO]"},"provenance":null},{"subject":{"scheme":"keyword","value":"Combinatorial Enumeration"},"provenance":null},{"subject":{"scheme":"keyword","value":"Ultrametric Spaces"},"provenance":null},{"subject":{"scheme":"keyword","value":"Combinatorics"},"provenance":null},{"subject":{"scheme":"keyword","value":"Fractal Hyper-Trees"},"provenance":null},{"subject":{"scheme":"keyword","value":"Recursive Structures"},"provenance":null},{"subject":{"scheme":"keyword","value":"FOS: Mathematics"},"provenance":null},{"subject":{"scheme":"keyword","value":"Combinatorics (math.CO)"},"provenance":null},{"subject":{"scheme":"keyword","value":"Hypergraphs"},"provenance":null},{"subject":{"scheme":"keyword","value":"Automorphism Groups"},"provenance":null},{"subject":{"scheme":"keyword","value":"p-Adic Analogues"},"provenance":null}],"mainTitle":"Fractal Hyper-Trees: Combinatorial Enumeration, Symmetry Properties, and Ultrametric Structures","subTitle":null,"descriptions":["This paper introduces and formalizes Fractal Hyper-Trees (FHT), a novel class of hypergraphs characterized by deep recursive inclusion hierarchies and controlled relational textures. Moving beyond classical graph-theoretic frameworks, we establish an axiomatic foundation for FHTs and investigate their combinatorial enumeration, revealing explicit connections to OEIS sequence A398931. Furthermore, we analyze the structural symmetry properties via automorphism groups, examine the resulting global hierarchical ultrametric topologies, and discuss asymptotic perspectives, including vertex substitution operators and heuristic parallels with $p$-adic integer rings."],"publicationDate":"2026-01-01","publisher":"arXiv","embargoEndDate":"2026-09-01","sources":null,"formats":["application/pdf"],"contributors":["Salone, Jean-Jacques"],"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::cac2d6800d8c5554ce9e427a245cd0ac","originalIds":["50|datacite____::cac2d6800d8c5554ce9e427a245cd0ac","10.48550/arxiv.2609.19895","50|od________18::22d34f29014ffd848024d02664962846","oai:arXiv.org:2609.19895","oai:HAL:hal-05748266v1","50|od_______166::03259d3ff771fe4eb7c1e21ebbe03f3e"],"pids":[{"scheme":"doi","value":"10.48550/arxiv.2609.19895"},{"scheme":"arXiv","value":"2609.19895"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1323419E-9,"popularity":2.5059315E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"University of the French West Indies and Guiana","acronym":"UAG","id":"openorgs____::41bca09e4d12d5742e9c03abc779edfd","pids":[{"scheme":"mag_id","value":"52585520"},{"scheme":"ROR","value":"https://ror.org/02ryfmr77"},{"scheme":"ISNI","value":"0000000494712972"},{"scheme":"wikidata","value":"Q829169"},{"scheme":"wikidata","value":"Q16682075"},{"scheme":"ISNI","value":"0000000121973053"},{"scheme":"GRID","value":"grid.412130.5"},{"scheme":"ISNI","value":"0000000405935227"}],"countries":[{"code":"GP","label":"Guadeloupe"}],"websiteurl":"http://www.univ-ag.fr/fr/index.html"},{"legalNam